import os

projectName = 'smjansson'

for cxx in builder.targets:
    binary = Extension.ExtLibrary(builder, cxx, projectName + ".ext")

    binary.compiler.defines += [
      'HAVE_STRING_H',
      'SOURCEMOD_BUILD'
    ]

    if cxx.target.platform == 'linux':
      binary.compiler.postlink += ['-lpthread', '-lrt']
    elif cxx.target.platform == 'mac':
      binary.compiler.cflags += ['-Wno-deprecated-declarations']
      binary.compiler.postlink += ['-framework', 'CoreServices']

    if cxx.family == 'gcc' or cxx.family == 'clang':
      binary.compiler.cxxflags += ['-fno-rtti']
    elif cxx.family == 'msvc':
      binary.compiler.cxxflags += ['/GR-']

    binary.sources += [
      'extension.cpp',
      os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp'),
    ]

    if Extension.jansson_root:
      # jansson's sources, with the build settings of jansson-config/
      binary.compiler.defines += ['HAVE_CONFIG_H']
      binary.sources += [
        os.path.join(Extension.jansson_root, 'src', source) for source in [
          'dtoa.c',
          'dump.c',
          'error.c',
          'hashtable.c',
          'hashtable_seed.c',
          'load.c',
          'memory.c',
          'pack_unpack.c',
          'strbuffer.c',
          'strconv.c',
          'utf.c',
          'value.c',
          'version.c',
        ]
      ]
    elif cxx.family == 'msvc':
      # The installed jansson, found through the LIB environment variable
      binary.compiler.postlink += ['jansson.lib']
    else:
      binary.compiler.postlink += ['-ljansson']

    Extension.extensions += [builder.Add(binary)]
